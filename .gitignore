# Ad-hoc pipeline output. Curated runs that back a published number live in
# benchmarks/published_runs/ instead, and ARE committed: an accuracy figure
# whose run cannot be re-examined is a claim, not a benchmark.
results/
__pycache__/
*.pyc
.DS_Store
MERMaid/pdfdir/*.pdf

# uv environments built by install-uv.sh (and the conda-named symlinks
# run_pipeline probes for). Machine-local; the symlinks carry host paths.
.venv*/
.venvs/
